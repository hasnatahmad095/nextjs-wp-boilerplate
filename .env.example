# Base URL of your WordPress site (no trailing slash).
# The REST API is expected at: <base>/wp-json/wp/v2
NEXT_PUBLIC_API_BASE_URL=https://your-wordpress-site.com

# Optional: WordPress page IDs used by the example pages.
# Leave unset to fall back to the placeholders in the page files.
NEXT_PUBLIC_HOME_PAGE_ID=
NEXT_PUBLIC_PROJECTS_PAGE_ID=
NEXT_PUBLIC_REGIONS_PAGE_ID=
